              && incoming().isVoided == false
              && incoming().diff(existing()).affectedKeys().hasOnly(['transactionDate', 'timeOfDay', 'transactionTime', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'birdAgeDaysAtTransaction', 'averageWeightGrams', 'sampleSize', 'temperatureC', 'humidityPct', 'remarks', 'updatedBy', 'updatedAt'])
