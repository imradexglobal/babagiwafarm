      // Saved Work-in-Progress Drafts
      match /drafts/{draftId} {
        allow get: if isValidId(farmId) && isValidId(draftId) && isActiveMember(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && isActiveMember(farmId);
        allow create: if isValidId(farmId)
          && isValidId(draftId)
          && isActiveMember(farmId)
          && isValidRecordDraft(incoming(), farmId, draftId)
          && (hasCrudPerm(farmId, 'production', 'create') || hasCrudPerm(farmId, 'batches', 'create') || hasCrudPerm(farmId, 'feed', 'create'))
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId)
          && isValidId(draftId)
          && isActiveMember(farmId)
          && isValidRecordDraft(incoming(), farmId, draftId)
          && (hasCrudPerm(farmId, 'production', 'create') || hasCrudPerm(farmId, 'batches', 'create') || hasCrudPerm(farmId, 'feed', 'create'))
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().draftType == existing().draftType
          && incoming().createdBy == existing().createdBy
          && incoming().createdByName == existing().createdByName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'transactionDate', 'batchId', 'payload', 'updatedBy', 'updatedAt']);
        allow delete: if isValidId(farmId)
          && isValidId(draftId)
          && isActiveMember(farmId)
          && (hasCrudPerm(farmId, 'production', 'create') || hasCrudPerm(farmId, 'batches', 'create') || hasCrudPerm(farmId, 'feed', 'create'));
      }

      // Scheduled Vaccinations & Batch Age Milestone Reminders
      match /farmReminders/{reminderId} {
        allow get: if isValidId(farmId)
          && isValidId(reminderId)
          && (hasCrudPerm(farmId, 'production', 'read') || hasCrudPerm(farmId, 'batches', 'read') || canReadReports(farmId));
        allow list: if isValidId(farmId)
          && isEmailVerified()
          && (hasCrudPerm(farmId, 'production', 'read') || hasCrudPerm(farmId, 'batches', 'read') || canReadReports(farmId));
        allow create: if isValidId(farmId)
          && isValidId(reminderId)
          && isValidFarmReminder(incoming(), farmId, reminderId)
          && (hasCrudPerm(farmId, 'production', 'create') || hasCrudPerm(farmId, 'batches', 'create'))
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/farms/$(farmId)/batches/$(incoming().batchId));
        allow update: if isValidId(farmId)
          && isValidId(reminderId)
          && isValidFarmReminder(incoming(), farmId, reminderId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().batchId == existing().batchId
          && incoming().createdBy == existing().createdBy
          && incoming().createdByName == existing().createdByName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time
          && (
            (
              (hasCrudPerm(farmId, 'production', 'create') || hasCrudPerm(farmId, 'batches', 'create') || hasCrudPerm(farmId, 'production', 'edit') || hasCrudPerm(farmId, 'batches', 'edit'))
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAtDate', 'completedBy', 'completedByName', 'updatedBy', 'updatedAt'])
            ) ||
            (
              (hasCrudPerm(farmId, 'production', 'edit') || hasCrudPerm(farmId, 'batches', 'edit'))
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'reminderType', 'dueDate', 'targetAgeDays', 'dosageOrAction', 'notes', 'status', 'completedAtDate', 'completedBy', 'completedByName', 'carePlanId', 'carePlanItemId', 'intervalUnit', 'intervalValue', 'occurrenceIndex', 'parentReminderId', 'updatedBy', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

      // Care Plan Templates
      match /carePlans/{planId} {
        allow get, list: if isValidId(farmId) && (isActiveMember(farmId) || isBoundToFarm(farmId));
        allow create: if isValidId(farmId) && isValidId(planId)
          && (canEditSettings(farmId) || hasCrudPerm(farmId, 'production', 'create') || hasCrudPerm(farmId, 'batches', 'create'))
          && incoming().id == planId
          && incoming().farmId == farmId
          && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
          && incoming().description is string && incoming().description.size() <= 300
          && incoming().planType in ['medication', 'vaccination', 'activity']
          && incoming().status in ['active', 'inactive']
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId) && isValidId(planId)
          && (canEditSettings(farmId) || hasCrudPerm(farmId, 'production', 'edit') || hasCrudPerm(farmId, 'batches', 'edit'))
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(farmId) && isValidId(planId)
          && (canEditSettings(farmId) || isFarmOwner(farmId));

        match /items/{itemId} {
          allow get, list: if isValidId(farmId) && (isActiveMember(farmId) || isBoundToFarm(farmId));
          allow create: if isValidId(farmId) && isValidId(itemId)
            && (canEditSettings(farmId) || hasCrudPerm(farmId, 'production', 'create') || hasCrudPerm(farmId, 'batches', 'create'))
            && incoming().id == itemId
            && incoming().carePlanId == planId
            && incoming().farmId == farmId
            && incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 140
            && incoming().reminderType in ['vaccination', 'medication', 'milestone']
            && incoming().intervalUnit in ['once', 'hour', 'day', 'week', 'month']
            && incoming().createdBy == request.auth.uid
            && incoming().updatedBy == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time;
          allow update: if isValidId(farmId) && isValidId(itemId)
            && (canEditSettings(farmId) || hasCrudPerm(farmId, 'production', 'edit') || hasCrudPerm(farmId, 'batches', 'edit'))
            && incoming().id == existing().id
            && incoming().carePlanId == existing().carePlanId
            && incoming().farmId == existing().farmId
            && incoming().createdBy == existing().createdBy
            && incoming().createdAt == existing().createdAt
            && incoming().updatedBy == request.auth.uid
            && incoming().updatedAt == request.time;
          allow delete: if isValidId(farmId) && isValidId(itemId)
            && (canEditSettings(farmId) || isFarmOwner(farmId) || hasCrudPerm(farmId, 'production', 'delete'));
        }
      }

      // Egg Store settings
      match /eggStoreSettings/{settingsId} {
        allow get: if isValidId(farmId) && settingsId == 'current' && (canReadEggStore(farmId) || canReadSettings(farmId) || canEditSettings(farmId));
        allow list: if false;
        allow create: if isValidId(farmId) && settingsId == 'current'
          && isValidEggStoreSettings(incoming(), farmId)
          && canEditSettings(farmId)
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId) && settingsId == 'current'
          && isValidEggStoreSettings(incoming(), farmId)
          && canEditSettings(farmId)
          && incoming().id == existing().id && incoming().farmId == existing().farmId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['salesMode', 'inventoryOrganization', 'gradingMode', 'grades', 'allowCrackedSales', 'allowDamagedSales', 'openingStockCompleted', 'updatedBy', 'updatedAt']);
        allow delete: if false;
      }

      // Remaining quantities available for transfer from each production record
      match /eggProductionTransferBalances/{entryId} {
        allow get: if isValidId(farmId) && isValidId(entryId) && canReadEggStore(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && canReadEggStore(farmId);
        allow create: if isValidId(farmId) && isValidId(entryId)
          && isValidEggProductionTransferBalance(incoming(), farmId, entryId)
          && hasCrudPerm(farmId, 'eggStore', 'transfer')
          && incoming().updatedBy == request.auth.uid && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(entryId))
          && get(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(entryId)).data.isVoided == false
      && get(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(entryId)).data.status == 'APPROVED'
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.productionEntryId == entryId
          && incoming().remainingIntactEggs == get(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(entryId)).data.intactEggs - getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.quantities.intactEggs
          && incoming().remainingCrackedEggs == get(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(entryId)).data.crackedEggs - getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.quantities.crackedEggs
          && incoming().remainingDamagedEggs == get(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(entryId)).data.damagedEggs - getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.quantities.damagedEggs;
        allow update: if isValidId(farmId) && isValidId(entryId)
          && isValidEggProductionTransferBalance(incoming(), farmId, entryId)
          && hasCrudPerm(farmId, 'eggStore', 'transfer')
          && incoming().id == existing().id && incoming().farmId == existing().farmId
          && incoming().productionEntryId == existing().productionEntryId
          && incoming().updatedBy == request.auth.uid && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['remainingIntactEggs', 'remainingCrackedEggs', 'remainingDamagedEggs', 'lastTransferId', 'updatedBy', 'updatedAt'])
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.productionEntryId == entryId
          && incoming().remainingIntactEggs == existing().remainingIntactEggs - getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.quantities.intactEggs
          && incoming().remainingCrackedEggs == existing().remainingCrackedEggs - getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.quantities.crackedEggs
          && incoming().remainingDamagedEggs == existing().remainingDamagedEggs - getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(incoming().lastTransferId)).data.quantities.damagedEggs;
        allow delete: if false;
      }

      // Production-to-store transfers; receipt status can only be advanced once
      match /eggTransfers/{transferId} {
        allow get: if isValidId(farmId) && isValidId(transferId) && canReadEggStore(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && canReadEggStore(farmId);
        allow create: if isValidId(farmId) && isValidId(transferId)
          && isValidEggTransfer(incoming(), farmId, transferId)
          && hasCrudPerm(farmId, 'eggStore', 'transfer')
          && incoming().status == 'awaiting_receipt'
          && incoming().transferredBy == request.auth.uid
          && incoming().receivedBy == '' && incoming().receivedByName == ''
          && incoming().createdAt == request.time && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(incoming().productionEntryId))
          && get(/databases/$(database)/documents/farms/$(farmId)/eggProduction/$(incoming().productionEntryId)).data.isVoided == false
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggProductionTransferBalances/$(incoming().productionEntryId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggProductionTransferBalances/$(incoming().productionEntryId)).data.lastTransferId == transferId;
        allow update: if isValidId(farmId) && isValidId(transferId)
          && isValidEggTransfer(incoming(), farmId, transferId)
          && hasCrudPerm(farmId, 'eggStore', 'receive')
          && existing().status == 'awaiting_receipt' && incoming().status == 'received'
          && incoming().id == existing().id && incoming().farmId == existing().farmId
          && incoming().productionEntryId == existing().productionEntryId
          && incoming().quantities == existing().quantities && incoming().totalEggs == existing().totalEggs
          && incoming().transferredBy == existing().transferredBy && incoming().createdAt == existing().createdAt
          && incoming().receivedBy == request.auth.uid && incoming().receivedByName.size() >= 1
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'receivedBy', 'receivedByName', 'updatedAt'])
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(transferId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(transferId)).data.transferId == transferId
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(transferId)).data.receivedBy == request.auth.uid;
        allow delete: if false;
      }

      // Physical receipts are keyed by transfer ID to prevent duplicate intake
      match /eggStoreReceipts/{receiptId} {
        allow get: if isValidId(farmId) && isValidId(receiptId) && canReadEggStore(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && canReadEggStore(farmId);
        allow create: if isValidId(farmId) && isValidId(receiptId)
          && isValidEggStoreReceipt(incoming(), farmId, receiptId)
          && hasCrudPerm(farmId, 'eggStore', 'receive')
          && incoming().receivedBy == request.auth.uid && incoming().receivedAt == request.time
          && exists(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(receiptId))
          && get(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(receiptId)).data.status == 'awaiting_receipt'
          && get(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(receiptId)).data.quantities == incoming().expected
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(receiptId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggTransfers/$(receiptId)).data.status == 'received';
        allow update, delete: if false;
      }

      // Sorting is a one-time, exactly reconciled classification of one receipt
      match /eggSortingBatches/{sortingId} {
        allow get: if isValidId(farmId) && isValidId(sortingId) && canReadEggStore(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && canReadEggStore(farmId);
        allow create: if isValidId(farmId) && isValidId(sortingId)
          && isValidEggSortingBatch(incoming(), farmId, sortingId)
          && hasCrudPerm(farmId, 'eggStore', 'sort')
          && incoming().sortedBy == request.auth.uid && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(sortingId))
          && get(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(sortingId)).data.received == incoming().inputs;
        allow update, delete: if false;
      }

      // Inventory balances are writable only together with their exact ledger movement
      match /eggInventoryBalances/{balanceId} {
        allow get: if isValidId(farmId) && isValidId(balanceId) && canReadEggStore(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && canReadEggStore(farmId);
        allow create: if isValidId(farmId) && isValidId(balanceId)
          && isValidEggInventoryBalance(incoming(), farmId, balanceId)
          && incoming().balanceEggs > 0
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.balanceId == balanceId
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.quantityDelta == incoming().balanceEggs
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.category == incoming().category
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.lotId == incoming().lotId;
        allow update: if isValidId(farmId) && isValidId(balanceId)
          && isValidEggInventoryBalance(incoming(), farmId, balanceId)
          && incoming().id == existing().id && incoming().farmId == existing().farmId
          && incoming().category == existing().category && incoming().sourcePenId == existing().sourcePenId
          && incoming().sourcePenNameSnapshot == existing().sourcePenNameSnapshot && incoming().lotId == existing().lotId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['balanceEggs', 'lastMovementId', 'updatedAt'])
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.balanceId == balanceId
          && incoming().balanceEggs == existing().balanceEggs + getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.quantityDelta
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.category == incoming().category
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryMovements/$(incoming().lastMovementId)).data.lotId == incoming().lotId;
        allow delete: if false;
      }

      // Immutable append-only stock movement ledger
      match /eggInventoryMovements/{movementId} {
        allow get: if isValidId(farmId) && isValidId(movementId) && canReadEggStore(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && canReadEggStore(farmId);
        allow create: if isValidId(farmId) && isValidId(movementId)
          && isValidEggInventoryMovement(incoming(), farmId, movementId)
          && (canPostEggMovement(farmId, incoming().movementType, incoming().quantityDelta)
            || (incoming().movementType == 'adjustment'
              && incoming().reason == 'Sale edited'
              && isValidId(incoming().reference)
              && hasCrudPerm(farmId, 'sales', 'edit')
              && exists(/databases/$(database)/documents/farms/$(farmId)/eggSales/$(incoming().reference))
              && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggSales/$(incoming().reference))
              && get(/databases/$(database)/documents/farms/$(farmId)/eggSales/$(incoming().reference)).data.totalEggsEquivalent - getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSales/$(incoming().reference)).data.totalEggsEquivalent == incoming().quantityDelta))
          && incoming().actorUid == request.auth.uid && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryBalances/$(incoming().balanceId))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryBalances/$(incoming().balanceId)).data.lastMovementId == movementId
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryBalances/$(incoming().balanceId)).data.category == incoming().category
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggInventoryBalances/$(incoming().balanceId)).data.lotId == incoming().lotId
          && (incoming().movementType != 'opening_stock' || (existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreSettings/current) && getAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreSettings/current).data.openingStockCompleted == true))
          && (incoming().movementType != 'store_receipt' || (existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(incoming().receiptId)) && incoming().transferId == incoming().receiptId))
          && ((incoming().movementType != 'sorting_in' && incoming().movementType != 'sorting_out') || (existsAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)) && incoming().receiptId == incoming().sortingBatchId))
          && (incoming().movementType != 'store_receipt' || (
            (incoming().category == 'Unsorted' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(incoming().receiptId)).data.received.intactEggs) ||
            (incoming().category == 'Cracked' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(incoming().receiptId)).data.received.crackedEggs) ||
            (incoming().category == 'Damaged' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggStoreReceipts/$(incoming().receiptId)).data.received.damagedEggs)
          ))
          && (incoming().movementType != 'sorting_in' || (
            (incoming().category == 'Jumbo' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.gradeTotals.Jumbo) ||
            (incoming().category == 'Big' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.gradeTotals.Big) ||
            (incoming().category == 'Medium' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.gradeTotals.Medium) ||
            (incoming().category == 'Small' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.gradeTotals.Small) ||
            (incoming().category == 'Pullet' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.gradeTotals.Pullet) ||
            (incoming().category == 'Unsorted' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.gradeTotals.Unsorted) ||
            (incoming().category == 'Cracked' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.crackedEggs) ||
            (incoming().category == 'Damaged' && incoming().quantityDelta == getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.damagedEggs)
          ))
          && (incoming().movementType != 'sorting_out' || (
            (incoming().category == 'Unsorted' && incoming().quantityDelta == -getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.inputs.intactEggs) ||
            (incoming().category == 'Cracked' && incoming().quantityDelta == -getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.inputs.crackedEggs) ||
            (incoming().category == 'Damaged' && incoming().quantityDelta == -getAfter(/databases/$(database)/documents/farms/$(farmId)/eggSortingBatches/$(incoming().sortingBatchId)).data.inputs.damagedEggs)
          ));
        allow update, delete: if false;
      }

      // -------------------------------------------------------------------------
      // Accounts: Customers, Vendors, Invoices, and Account Payments
      // -------------------------------------------------------------------------
      match /customers/{customerId} {
        allow get, list: if isValidId(farmId) && (isActiveMember(farmId) || isBoundToFarm(farmId));
        allow create: if isValidId(farmId) && isValidId(customerId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && isValidCustomer(incoming(), farmId, customerId)
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId) && isValidId(customerId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && isValidCustomer(incoming(), farmId, customerId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }

      match /vendors/{vendorId} {
        allow get, list: if isValidId(farmId) && (isActiveMember(farmId) || isBoundToFarm(farmId));
        allow create: if isValidId(farmId) && isValidId(vendorId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && isValidVendor(incoming(), farmId, vendorId)
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId) && isValidId(vendorId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && isValidVendor(incoming(), farmId, vendorId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }

      match /salesInvoices/{invoiceId} {
        allow get, list: if isValidId(farmId) && (isActiveMember(farmId) || isBoundToFarm(farmId));
        allow create: if isValidId(farmId) && isValidId(invoiceId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && incoming().id == invoiceId
          && incoming().farmId == farmId
          && incoming().createdBy == request.auth.uid
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId) && isValidId(invoiceId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }

      match /purchaseInvoices/{invoiceId} {
        allow get, list: if isValidId(farmId) && (isActiveMember(farmId) || isBoundToFarm(farmId));
        allow create: if isValidId(farmId) && isValidId(invoiceId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && incoming().id == invoiceId
          && incoming().farmId == farmId
          && incoming().createdBy == request.auth.uid
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId) && isValidId(invoiceId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }

      match /accountPayments/{paymentId} {
        allow get, list: if isValidId(farmId) && (isActiveMember(farmId) || isBoundToFarm(farmId));
        allow create: if isValidId(farmId) && isValidId(paymentId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && incoming().id == paymentId
          && incoming().farmId == farmId
          && incoming().amountNgn is number
          && incoming().amountNgn > 0
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if isValidId(farmId) && isValidId(paymentId)
          && (isActiveMember(farmId) || isBoundToFarm(farmId))
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().amountNgn == existing().amountNgn
          && incoming().direction == existing().direction
          && incoming().partyId == existing().partyId
          && incoming().diff(existing()).affectedKeys().hasOnly(['isVoided', 'voidReason', 'voidedBy', 'updatedAt']);
        allow delete: if false;
      }
    }
  }
}
