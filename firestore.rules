              && incoming().diff(existing()).affectedKeys().hasOnly(['transactionDate', 'timeOfDay', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'birdAgeDaysAtTransaction', 'mortalityCount', 'reasonCategory', 'reasonDetail', 'remarks', 'updatedBy', 'updatedAt'])
