rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helper Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userEmailKey() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidOptionalDateStr(d) {
      return d is string && (d.size() == 0 || (d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$')));
    }

    function isValidTimeStr(t) {
      return t is string && (t.size() == 0 || (t.size() == 5 && t.matches('^\\d{2}:\\d{2}$')));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Permission & Tenant Membership Gates
    // -------------------------------------------------------------------------
    function memberPath(farmId, uid) {
      return /databases/$(database)/documents/farms/$(farmId)/members/$(uid);
    }

    function getMember(farmId) {
      return get(memberPath(farmId, request.auth.uid));
    }

    function isActiveMember(farmId) {
      return isEmailVerified()
        && exists(memberPath(farmId, request.auth.uid))
        && getMember(farmId).data.status == 'active';
    }

    function isBoundToFarm(farmId) {
      return isEmailVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmId == farmId;
    }

    function isFarmOwner(farmId) {
      return (isActiveMember(farmId) && getMember(farmId).data.role == 'owner')
        || isBoundToFarm(farmId);
    }

    function canApproveProduction(farmId) {
      return isFarmOwner(farmId) || (isActiveMember(farmId) && getMember(farmId).data.permissions.production.approve == true);
    }

    function hasCrudPerm(farmId, domain, action) {
      return isFarmOwner(farmId) || (
        isActiveMember(farmId) && (
          getMember(farmId).data.role == 'owner' ||
          getMember(farmId).data.permissions[domain][action] == true
        )
      );
    }

    function canOverrideSalesPrice(farmId) {
      return isActiveMember(farmId) && (
        getMember(farmId).data.role == 'owner' ||
        getMember(farmId).data.permissions.sales.overridePrice == true
      );
    }

    function canReadReports(farmId) {
      return isActiveMember(farmId) && (
        getMember(farmId).data.role == 'owner' ||
        getMember(farmId).data.permissions.reports.read == true
      );
    }

    function canReadEggStore(farmId) {
      return canReadReports(farmId)
        || hasCrudPerm(farmId, 'eggStore', 'read')
        || hasCrudPerm(farmId, 'eggStore', 'transfer')
        || hasCrudPerm(farmId, 'eggStore', 'receive')
        || hasCrudPerm(farmId, 'eggStore', 'sort')
        || hasCrudPerm(farmId, 'eggStore', 'adjust')
        || hasCrudPerm(farmId, 'eggStore', 'distribute')
        || hasCrudPerm(farmId, 'eggStore', 'dispose');
    }

    function canPostEggMovement(farmId, movementType, quantityDelta) {
      return (movementType == 'opening_stock' && quantityDelta > 0 && canEditSettings(farmId))
        || (movementType == 'store_receipt' && quantityDelta > 0 && hasCrudPerm(farmId, 'eggStore', 'receive'))
        || ((movementType == 'sorting_in' && quantityDelta > 0 || movementType == 'sorting_out' && quantityDelta < 0) && hasCrudPerm(farmId, 'eggStore', 'sort'))
        || (movementType == 'sale' && quantityDelta < 0 && hasCrudPerm(farmId, 'sales', 'create')
          && exists(/databases/$(database)/documents/farms/$(farmId)/eggStoreSettings/current)
          && get(/databases/$(database)/documents/farms/$(farmId)/eggStoreSettings/current).data.salesMode == 'true_inventory')
        || (movementType == 'free_distribution' && quantityDelta < 0 && hasCrudPerm(farmId, 'eggStore', 'distribute'))
        || (movementType == 'breakage' && quantityDelta < 0 && hasCrudPerm(farmId, 'eggStore', 'adjust'))
        || (movementType == 'adjustment' && hasCrudPerm(farmId, 'eggStore', 'adjust'))
        || (movementType == 'disposal' && quantityDelta < 0 && hasCrudPerm(farmId, 'eggStore', 'dispose'))
        || (movementType == 'reversal' && (isFarmOwner(farmId) || hasCrudPerm(farmId, 'sales', 'delete')));
    }

    function canReadSettings(farmId) {
      return isActiveMember(farmId) && (
        getMember(farmId).data.role == 'owner' ||
        getMember(farmId).data.permissions.settings.read == true
      );
    }

    function canEditSettings(farmId) {
      return isActiveMember(farmId) && (
        getMember(farmId).data.role == 'owner' ||
        getMember(farmId).data.permissions.settings.edit == true
      );
    }

    function canReadMembers(farmId) {
      return isActiveMember(farmId) && (
        getMember(farmId).data.role == 'owner' ||
        getMember(farmId).data.permissions.members.read == true
      );
    }

    function canManageMembers(farmId) {
      return isActiveMember(farmId) && (
        getMember(farmId).data.role == 'owner' ||
        getMember(farmId).data.permissions.members.manage == true
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidProductionPerm(m) {
      return m is map
        && m.keys().hasAll(['read', 'create', 'edit', 'delete', 'approve'])
        && m.keys().hasOnly(['read', 'create', 'edit', 'delete', 'approve'])
        && m.read is bool && m.create is bool && m.edit is bool && m.delete is bool && m.approve is bool;
    }

    function isValidPermCrud(m) {
      return m is map
        && m.keys().hasAll(['read', 'create', 'edit', 'delete'])
        && m.keys().hasOnly(['read', 'create', 'edit', 'delete'])
        && m.read is bool && m.create is bool && m.edit is bool && m.delete is bool;
    }

    function isValidPermissions(p) {
      return p is map
        && p.keys().hasAll(['batches', 'production', 'feed', 'sales', 'reports', 'settings', 'members', 'eggStore'])
        && p.keys().hasOnly(['batches', 'production', 'feed', 'sales', 'reports', 'settings', 'members', 'eggStore'])
        && isValidPermCrud(p.batches)
        && isValidProductionPerm(p.production)
        && isValidPermCrud(p.feed)
        && p.sales is map
        && p.sales.keys().hasAll(['read', 'create', 'edit', 'delete', 'overridePrice'])
        && p.sales.keys().hasOnly(['read', 'create', 'edit', 'delete', 'overridePrice'])
        && p.sales.read is bool && p.sales.create is bool && p.sales.edit is bool && p.sales.delete is bool && p.sales.overridePrice is bool
        && p.reports is map
        && p.reports.keys().hasAll(['read', 'export'])
        && p.reports.keys().hasOnly(['read', 'export'])
        && p.reports.read is bool && p.reports.export is bool
        && p.settings is map
        && p.settings.keys().hasAll(['read', 'edit'])
        && p.settings.keys().hasOnly(['read', 'edit'])
        && p.settings.read is bool && p.settings.edit is bool
        && p.members is map
        && p.members.keys().hasAll(['read', 'manage'])
        && p.members.keys().hasOnly(['read', 'manage'])
        && p.members.read is bool && p.members.manage is bool
        && p.eggStore is map
        && p.eggStore.keys().hasAll(['read', 'transfer', 'receive', 'sort', 'adjust', 'distribute', 'dispose'])
        && p.eggStore.keys().hasOnly(['read', 'transfer', 'receive', 'sort', 'adjust', 'distribute', 'dispose'])
        && p.eggStore.read is bool && p.eggStore.transfer is bool && p.eggStore.receive is bool
        && p.eggStore.sort is bool && p.eggStore.adjust is bool
        && p.eggStore.distribute is bool && p.eggStore.dispose is bool;
    }

    function isValidEggQuantities(q) {
      return q is map
        && q.keys().hasAll(['intactEggs', 'crackedEggs', 'damagedEggs'])
        && q.keys().hasOnly(['intactEggs', 'crackedEggs', 'damagedEggs'])
        && q.intactEggs is int && q.intactEggs >= 0 && q.intactEggs <= 1000000
        && q.crackedEggs is int && q.crackedEggs >= 0 && q.crackedEggs <= 1000000
        && q.damagedEggs is int && q.damagedEggs >= 0 && q.damagedEggs <= 1000000;
    }

    function isValidEggStoreSettings(d, farmId) {
      return d.keys().hasAll(['id', 'farmId', 'salesMode', 'inventoryOrganization', 'gradingMode', 'grades', 'allowCrackedSales', 'allowDamagedSales', 'openingStockCompleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'salesMode', 'inventoryOrganization', 'gradingMode', 'grades', 'allowCrackedSales', 'allowDamagedSales', 'openingStockCompleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.id == 'current' && d.farmId == farmId
        && d.salesMode in ['phantom', 'true_inventory']
        && d.inventoryOrganization in ['pen_based', 'mixed']
        && d.gradingMode in ['graded', 'unsorted']
        && d.grades is list && d.grades.size() >= 1 && d.grades.size() <= 6
        && d.grades.hasOnly(['Jumbo', 'Big', 'Medium', 'Small', 'Pullet', 'Unsorted'])
        && d.allowCrackedSales is bool && d.allowDamagedSales is bool
        && d.openingStockCompleted is bool
        && (d.salesMode != 'true_inventory' || d.openingStockCompleted == true)
        && isValidId(d.createdBy) && isValidId(d.updatedBy)
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidEggTransfer(d, farmId, transferId) {
      return d.keys().hasAll(['id', 'farmId', 'productionEntryId', 'productionDate', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'quantities', 'totalEggs', 'reference', 'remarks', 'status', 'transferredBy', 'transferredByName', 'receivedBy', 'receivedByName', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'productionEntryId', 'productionDate', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'quantities', 'totalEggs', 'reference', 'remarks', 'status', 'transferredBy', 'transferredByName', 'receivedBy', 'receivedByName', 'createdAt', 'updatedAt'])
        && d.id == transferId && d.farmId == farmId
        && isValidId(d.productionEntryId) && isValidDateStr(d.productionDate)
        && isValidId(d.batchId) && isValidId(d.penId)
        && d.batchCodeSnapshot is string && d.batchCodeSnapshot.size() >= 1 && d.batchCodeSnapshot.size() <= 60
        && d.penNameSnapshot is string && d.penNameSnapshot.size() >= 1 && d.penNameSnapshot.size() <= 80
        && isValidEggQuantities(d.quantities)
        && d.totalEggs == d.quantities.intactEggs + d.quantities.crackedEggs + d.quantities.damagedEggs
        && d.totalEggs > 0 && d.totalEggs <= 3000000
        && d.reference is string && d.reference.size() <= 80
        && d.remarks is string && d.remarks.size() <= 500
        && d.status in ['awaiting_receipt', 'received', 'voided']
        && isValidId(d.transferredBy) && d.transferredByName is string && d.transferredByName.size() >= 1 && d.transferredByName.size() <= 150
        && d.receivedBy is string && d.receivedBy.size() <= 128
        && d.receivedByName is string && d.receivedByName.size() <= 150
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    function isValidEggProductionTransferBalance(d, farmId, productionEntryId) {
      return d.keys().hasAll(['id', 'farmId', 'productionEntryId', 'remainingIntactEggs', 'remainingCrackedEggs', 'remainingDamagedEggs', 'lastTransferId', 'updatedBy', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'productionEntryId', 'remainingIntactEggs', 'remainingCrackedEggs', 'remainingDamagedEggs', 'lastTransferId', 'updatedBy', 'updatedAt'])
        && d.id == productionEntryId && d.productionEntryId == productionEntryId && d.farmId == farmId
        && d.remainingIntactEggs is int && d.remainingIntactEggs >= 0 && d.remainingIntactEggs <= 3000000
        && d.remainingCrackedEggs is int && d.remainingCrackedEggs >= 0 && d.remainingCrackedEggs <= 1000000
        && d.remainingDamagedEggs is int && d.remainingDamagedEggs >= 0 && d.remainingDamagedEggs <= 1000000
        && isValidId(d.lastTransferId) && isValidId(d.updatedBy) && d.updatedAt is timestamp;
    }

    function isValidEggStoreReceipt(d, farmId, receiptId) {
      return d.keys().hasAll(['id', 'farmId', 'transferId', 'productionEntryId', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'expected', 'received', 'expectedTotalEggs', 'receivedTotalEggs', 'varianceEggs', 'remarks', 'receivedBy', 'receivedByName', 'receivedAt', 'transactionDate', 'transactionTime'])
        && d.keys().hasOnly(['id', 'farmId', 'transferId', 'productionEntryId', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'expected', 'received', 'expectedTotalEggs', 'receivedTotalEggs', 'varianceEggs', 'remarks', 'receivedBy', 'receivedByName', 'receivedAt', 'transactionDate', 'transactionTime'])
        && d.id == receiptId && d.transferId == receiptId && d.farmId == farmId
        && isValidId(d.productionEntryId) && isValidId(d.batchId) && isValidId(d.penId)
        && d.batchCodeSnapshot is string && d.batchCodeSnapshot.size() >= 1 && d.batchCodeSnapshot.size() <= 60
        && d.penNameSnapshot is string && d.penNameSnapshot.size() >= 1 && d.penNameSnapshot.size() <= 80
        && isValidEggQuantities(d.expected) && isValidEggQuantities(d.received)
        && d.expectedTotalEggs == d.expected.intactEggs + d.expected.crackedEggs + d.expected.damagedEggs
        && d.receivedTotalEggs == d.received.intactEggs + d.received.crackedEggs + d.received.damagedEggs
        && d.receivedTotalEggs > 0 && d.receivedTotalEggs <= d.expectedTotalEggs
        && d.varianceEggs == d.expectedTotalEggs - d.receivedTotalEggs
        && d.remarks is string && d.remarks.size() <= 500
        && isValidId(d.receivedBy) && d.receivedByName is string && d.receivedByName.size() >= 1 && d.receivedByName.size() <= 150
        && d.receivedAt is timestamp && isValidDateStr(d.transactionDate) && isValidTimeStr(d.transactionTime);
    }

    function isValidEggSortingBatch(d, farmId, sortingId) {
      return d.keys().hasAll(['id', 'farmId', 'receiptId', 'sourcePenId', 'sourcePenNameSnapshot', 'inputs', 'gradeTotals', 'crackedEggs', 'damagedEggs', 'inputTotalEggs', 'outputTotalEggs', 'transactionDate', 'transactionTime', 'remarks', 'sortedBy', 'sortedByName', 'createdAt'])
        && d.keys().hasOnly(['id', 'farmId', 'receiptId', 'sourcePenId', 'sourcePenNameSnapshot', 'inputs', 'gradeTotals', 'crackedEggs', 'damagedEggs', 'inputTotalEggs', 'outputTotalEggs', 'transactionDate', 'transactionTime', 'remarks', 'sortedBy', 'sortedByName', 'createdAt'])
        && d.id == sortingId && d.receiptId == sortingId && d.farmId == farmId
        && isValidId(d.sourcePenId) && d.sourcePenNameSnapshot is string && d.sourcePenNameSnapshot.size() >= 1 && d.sourcePenNameSnapshot.size() <= 80
        && isValidEggQuantities(d.inputs)
        && d.gradeTotals is map && d.gradeTotals.keys().hasAll(['Jumbo', 'Big', 'Medium', 'Small', 'Pullet', 'Unsorted'])
        && d.gradeTotals.keys().hasOnly(['Jumbo', 'Big', 'Medium', 'Small', 'Pullet', 'Unsorted'])
        && d.gradeTotals.Jumbo is int && d.gradeTotals.Jumbo >= 0
        && d.gradeTotals.Big is int && d.gradeTotals.Big >= 0
        && d.gradeTotals.Medium is int && d.gradeTotals.Medium >= 0
        && d.gradeTotals.Small is int && d.gradeTotals.Small >= 0
        && d.gradeTotals.Pullet is int && d.gradeTotals.Pullet >= 0
        && d.gradeTotals.Unsorted is int && d.gradeTotals.Unsorted >= 0
        && d.crackedEggs is int && d.crackedEggs >= 0
        && d.damagedEggs is int && d.damagedEggs >= 0
        && d.inputTotalEggs == d.inputs.intactEggs + d.inputs.crackedEggs + d.inputs.damagedEggs
        && d.outputTotalEggs == d.gradeTotals.Jumbo + d.gradeTotals.Big + d.gradeTotals.Medium + d.gradeTotals.Small + d.gradeTotals.Pullet + d.gradeTotals.Unsorted + d.crackedEggs + d.damagedEggs
        && d.inputTotalEggs == d.outputTotalEggs && d.inputTotalEggs > 0
        && isValidDateStr(d.transactionDate) && isValidTimeStr(d.transactionTime)
        && d.remarks is string && d.remarks.size() <= 500
        && isValidId(d.sortedBy) && d.sortedByName is string && d.sortedByName.size() >= 1 && d.sortedByName.size() <= 150
        && d.createdAt is timestamp;
    }

    function isValidEggInventoryBalance(d, farmId, balanceId) {
      return d.keys().hasAll(['id', 'farmId', 'category', 'sourcePenId', 'sourcePenNameSnapshot', 'lotId', 'balanceEggs', 'lastMovementId', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'category', 'sourcePenId', 'sourcePenNameSnapshot', 'lotId', 'balanceEggs', 'lastMovementId', 'updatedAt'])
        && d.id == balanceId && d.farmId == farmId
        && d.category in ['Jumbo', 'Big', 'Medium', 'Small', 'Pullet', 'Unsorted', 'Cracked', 'Damaged']
        && (d.sourcePenId == '' || isValidId(d.sourcePenId))
        && d.sourcePenNameSnapshot is string && d.sourcePenNameSnapshot.size() <= 80
        && isValidId(d.lotId) && d.balanceEggs is int && d.balanceEggs >= 0 && d.balanceEggs <= 3000000
        && isValidId(d.lastMovementId) && d.updatedAt is timestamp;
    }

    function isValidEggInventoryMovement(d, farmId, movementId) {
      return d.keys().hasAll(['id', 'farmId', 'movementType', 'category', 'balanceId', 'quantityDelta', 'sourcePenId', 'sourcePenNameSnapshot', 'lotId', 'productionEntryId', 'transferId', 'receiptId', 'sortingBatchId', 'invoiceId', 'invoiceLineId', 'reference', 'transactionDate', 'reason', 'remarks', 'actorUid', 'actorName', 'createdAt'])
        && d.keys().hasOnly(['id', 'farmId', 'movementType', 'category', 'balanceId', 'quantityDelta', 'sourcePenId', 'sourcePenNameSnapshot', 'lotId', 'productionEntryId', 'transferId', 'receiptId', 'sortingBatchId', 'invoiceId', 'invoiceLineId', 'reference', 'transactionDate', 'reason', 'remarks', 'actorUid', 'actorName', 'createdAt'])
        && d.id == movementId && d.farmId == farmId
        && d.movementType in ['opening_stock', 'store_receipt', 'sorting_in', 'sorting_out', 'sale', 'free_distribution', 'breakage', 'adjustment', 'disposal', 'reversal']
        && d.category in ['Jumbo', 'Big', 'Medium', 'Small', 'Pullet', 'Unsorted', 'Cracked', 'Damaged']
        && isValidId(d.balanceId)
        && d.quantityDelta is int && d.quantityDelta != 0 && d.quantityDelta >= -3000000 && d.quantityDelta <= 3000000
        && (d.sourcePenId == '' || isValidId(d.sourcePenId))
        && d.sourcePenNameSnapshot is string && d.sourcePenNameSnapshot.size() <= 80
        && isValidId(d.lotId)
        && (d.productionEntryId == '' || isValidId(d.productionEntryId))
        && (d.transferId == '' || isValidId(d.transferId))
        && (d.receiptId == '' || isValidId(d.receiptId))
        && (d.sortingBatchId == '' || isValidId(d.sortingBatchId))
        && (d.invoiceId == '' || isValidId(d.invoiceId))
        && (d.invoiceLineId == '' || isValidId(d.invoiceLineId))
        && d.reference is string && d.reference.size() <= 80
        && isValidDateStr(d.transactionDate)
        && d.reason is string && d.reason.size() >= 1 && d.reason.size() <= 160
        && d.remarks is string && d.remarks.size() <= 500
        && isValidId(d.actorUid) && d.actorName is string && d.actorName.size() >= 1 && d.actorName.size() <= 150
        && d.createdAt is timestamp;
    }

    function isValidUserBinding(d, uid) {
      return d.keys().hasAll(['uid', 'email', 'displayName', 'farmId', 'role', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'email', 'displayName', 'farmId', 'role', 'createdAt', 'updatedAt'])
        && d.uid == uid
        && d.uid == request.auth.uid
        && d.email is string && d.email.size() >= 3 && d.email.size() <= 200
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 150
        && isValidId(d.farmId)
        && d.role in ['owner', 'staff']
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidPendingInvite(d, emailKey) {
      return d.keys().hasAll(['emailKey', 'farmId', 'farmName', 'inviteId', 'emailLower', 'jobTitle', 'role', 'permissions', 'status', 'invitedBy', 'acceptedByUid', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['emailKey', 'farmId', 'farmName', 'inviteId', 'emailLower', 'jobTitle', 'role', 'permissions', 'departments', 'assignedPenIds', 'status', 'invitedBy', 'acceptedByUid', 'createdAt', 'updatedAt'])
        && d.emailKey == emailKey
        && isValidId(d.farmId)
        && d.farmName is string && d.farmName.size() >= 1 && d.farmName.size() <= 120
        && isValidId(d.inviteId)
        && d.emailLower is string && d.emailLower.size() >= 3 && d.emailLower.size() <= 200
        && d.jobTitle is string && d.jobTitle.size() >= 1 && d.jobTitle.size() <= 80
        && d.role in ['owner', 'staff']
        && isValidPermissions(d.permissions)
        && (!('departments' in d) || d.departments is list)
        && (!('assignedPenIds' in d) || d.assignedPenIds is list)
        && d.status in ['pending', 'accepted', 'revoked']
        && isValidId(d.invitedBy)
        && d.acceptedByUid is string && d.acceptedByUid.size() <= 128
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidFarm(d, farmId) {
      return d.keys().hasAll(['farmId', 'name', 'location', 'contactPhone', 'contactEmail', 'currency', 'timezone', 'activeSectors', 'ownerUid', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['farmId', 'name', 'location', 'contactPhone', 'contactEmail', 'currency', 'timezone', 'activeSectors', 'ownerUid', 'createdAt', 'updatedAt'])
        && d.farmId == farmId
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.location is string && d.location.size() <= 200
        && d.contactPhone is string && d.contactPhone.size() <= 60
        && d.contactEmail is string && d.contactEmail.size() <= 150
        && d.currency is string && d.currency.size() >= 3 && d.currency.size() <= 10
        && d.timezone is string && d.timezone.size() >= 2 && d.timezone.size() <= 64
        && d.activeSectors is list && d.activeSectors.size() >= 1 && d.activeSectors.size() <= 10
        && d.activeSectors[0] is string && d.activeSectors[0].size() <= 40
        && isValidId(d.ownerUid)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidFarmMember(d, farmId, memberUid) {
      return d.keys().hasAll(['uid', 'farmId', 'email', 'displayName', 'jobTitle', 'role', 'status', 'permissions', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'farmId', 'email', 'displayName', 'jobTitle', 'role', 'status', 'permissions', 'departments', 'assignedPenIds', 'createdBy', 'createdAt', 'updatedAt'])
        && d.uid == memberUid
        && d.farmId == farmId
        && d.email is string && d.email.size() >= 3 && d.email.size() <= 200
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 150
        && d.jobTitle is string && d.jobTitle.size() >= 1 && d.jobTitle.size() <= 80
        && d.role in ['owner', 'staff']
        && d.status in ['active', 'inactive']
        && isValidPermissions(d.permissions)
        && (!('departments' in d) || d.departments is list)
        && (!('assignedPenIds' in d) || d.assignedPenIds is list)
        && isValidId(d.createdBy)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidFarmInvite(d, farmId, inviteId) {
