        && d.penNameSnapshot is string && d.penNameSnapshot.size() >= 1 && d.penNameSnapshot.size() <= 80
        && d.birdAgeDaysAtTransaction is int && d.birdAgeDaysAtTransaction >= 0 && d.birdAgeDaysAtTransaction <= 5000
        && (d.averageWeightGrams == null || (d.averageWeightGrams is number && d.averageWeightGrams > 0 && d.averageWeightGrams <= 20000))
        && d.sampleSize is int && d.sampleSize >= 0 && d.sampleSize <= 10000
        && (d.temperatureC == null || (d.temperatureC is number && d.temperatureC >= -10 && d.temperatureC <= 70))
        && (d.humidityPct == null || (d.humidityPct is number && d.humidityPct >= 0 && d.humidityPct <= 100))
        && (d.averageWeightGrams != null || d.temperatureC != null || d.humidityPct != null)
        && d.remarks is string && d.remarks.size() <= 500
        && d.isVoided is bool
        && d.voidReason is string && d.voidReason.size() <= 300
        && d.voidedBy is string && d.voidedBy.size() <= 128
        && isValidId(d.createdBy)
        && d.createdByName is string && d.createdByName.size() >= 1 && d.createdByName.size() <= 150
        && isValidId(d.updatedBy)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidFarmPurchase(d, farmId, purchaseId) {
      return d.keys().hasAll(['id', 'farmId', 'transactionDate', 'category', 'itemName', 'quantity', 'unit', 'unitPriceNgn', 'totalCostNgn', 'supplier', 'reference', 'batchId', 'batchCodeSnapshot', 'remarks', 'isVoided', 'voidReason', 'voidedBy', 'createdBy', 'createdByName', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'transactionDate', 'category', 'itemName', 'quantity', 'unit', 'unitPriceNgn', 'totalCostNgn', 'supplier', 'reference', 'batchId', 'batchCodeSnapshot', 'remarks', 'isVoided', 'voidReason', 'voidedBy', 'createdBy', 'createdByName', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.id == purchaseId
        && d.farmId == farmId
        && isValidDateStr(d.transactionDate)
        && d.category in ['medication', 'vaccines_vet', 'supplements', 'chicks_stock', 'litter_bedding', 'packaging', 'utilities_fuel', 'equipment_repairs', 'labor', 'other']
        && d.itemName is string && d.itemName.size() >= 1 && d.itemName.size() <= 120
        && d.quantity is number && d.quantity > 0
        && d.unit is string && d.unit.size() >= 1 && d.unit.size() <= 40
        && d.unitPriceNgn is number && d.unitPriceNgn >= 0
        && d.totalCostNgn is number && d.totalCostNgn >= 0
        && d.supplier is string && d.supplier.size() <= 120
        && d.reference is string && d.reference.size() <= 80
        && d.batchId is string && d.batchId.size() <= 128
        && d.batchCodeSnapshot is string && d.batchCodeSnapshot.size() <= 60
        && d.remarks is string && d.remarks.size() <= 500
        && d.isVoided is bool
        && d.voidReason is string && d.voidReason.size() <= 300
        && d.voidedBy is string && d.voidedBy.size() <= 128
        && isValidId(d.createdBy)
        && d.createdByName is string && d.createdByName.size() >= 1 && d.createdByName.size() <= 150
        && isValidId(d.updatedBy)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidRecordDraft(d, farmId, draftId) {
      return d.keys().hasAll(['id', 'farmId', 'draftType', 'title', 'transactionDate', 'batchId', 'payload', 'createdBy', 'createdByName', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'draftType', 'title', 'transactionDate', 'batchId', 'payload', 'createdBy', 'createdByName', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.id == draftId
        && d.farmId == farmId
        && d.draftType in ['daily_production', 'purchase']
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 160
        && isValidOptionalDateStr(d.transactionDate)
        && d.batchId is string && d.batchId.size() <= 128
        && d.payload is map && d.payload.size() <= 40
        && isValidId(d.createdBy)
        && d.createdByName is string && d.createdByName.size() >= 1 && d.createdByName.size() <= 150
      && isValidId(d.updatedBy)
      && d.createdAt is timestamp
      && d.updatedAt is timestamp;
    }

    function isValidFarmReminder(d, farmId, reminderId) {
      return d.keys().hasAll(['id', 'farmId', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'milestoneKey', 'reminderType', 'title', 'dueDate', 'targetAgeDays', 'dosageOrAction', 'notes', 'status', 'completedAtDate', 'completedBy', 'completedByName', 'createdBy', 'createdByName', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'milestoneKey', 'reminderType', 'title', 'dueDate', 'targetAgeDays', 'dosageOrAction', 'notes', 'status', 'completedAtDate', 'completedBy', 'completedByName', 'carePlanId', 'carePlanItemId', 'intervalUnit', 'intervalValue', 'occurrenceIndex', 'parentReminderId', 'createdBy', 'createdByName', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.id == reminderId
        && d.farmId == farmId
        && isValidId(d.batchId)
        && d.batchCodeSnapshot is string && d.batchCodeSnapshot.size() >= 1 && d.batchCodeSnapshot.size() <= 60
        && isValidId(d.penId)
        && d.penNameSnapshot is string && d.penNameSnapshot.size() >= 1 && d.penNameSnapshot.size() <= 80
        && d.milestoneKey is string && d.milestoneKey.size() <= 80
        && d.reminderType in ['vaccination', 'medication', 'milestone']
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 140
        && isValidDateStr(d.dueDate)
        && (d.targetAgeDays == null || (d.targetAgeDays is int && d.targetAgeDays >= 0 && d.targetAgeDays <= 2000))
        && d.dosageOrAction is string && d.dosageOrAction.size() <= 140
        && d.notes is string && d.notes.size() <= 500
        && d.status in ['pending', 'completed', 'dismissed']
        && isValidOptionalDateStr(d.completedAtDate)
        && d.completedBy is string && d.completedBy.size() <= 128
        && d.completedByName is string && d.completedByName.size() <= 150
        && (
          (d.status == 'pending' && d.completedAtDate == '' && d.completedBy == '' && d.completedByName == '')
          || (d.status in ['completed', 'dismissed'] && isValidDateStr(d.completedAtDate) && isValidId(d.completedBy) && d.completedByName.size() >= 1)
        )
        && (!('carePlanId' in d) || (d.carePlanId is string && d.carePlanId.size() <= 128))
        && (!('carePlanItemId' in d) || (d.carePlanItemId is string && d.carePlanItemId.size() <= 128))
        && (!('intervalUnit' in d) || (d.intervalUnit in ['once', 'hour', 'day', 'week', 'month']))
        && (!('intervalValue' in d) || (d.intervalValue is int && d.intervalValue >= 1))
        && (!('occurrenceIndex' in d) || (d.occurrenceIndex is int && d.occurrenceIndex >= 0))
        && (!('parentReminderId' in d) || (d.parentReminderId is string && d.parentReminderId.size() <= 128))
        && isValidId(d.createdBy)
        && d.createdByName is string && d.createdByName.size() >= 1 && d.createdByName.size() <= 150
        && isValidId(d.updatedBy)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidCustomer(d, farmId, customerId) {
      return d.keys().hasAll(['id', 'farmId', 'name', 'phone', 'email', 'address', 'notes', 'openingBalanceNgn', 'openingBalanceDate', 'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'name', 'phone', 'email', 'address', 'notes', 'openingBalanceNgn', 'openingBalanceDate', 'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.id == customerId
        && d.farmId == farmId
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 150
        && d.phone is string && d.phone.size() <= 40
        && d.email is string && d.email.size() <= 200
        && d.address is string && d.address.size() <= 300
        && d.notes is string && d.notes.size() <= 500
        && d.openingBalanceNgn is number && d.openingBalanceNgn >= 0
        && isValidOptionalDateStr(d.openingBalanceDate)
        && d.status in ['active', 'inactive']
        && isValidId(d.createdBy)
        && isValidId(d.updatedBy)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidVendor(d, farmId, vendorId) {
      return d.keys().hasAll(['id', 'farmId', 'name', 'phone', 'email', 'address', 'notes', 'openingBalanceNgn', 'openingBalanceDate', 'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'farmId', 'name', 'phone', 'email', 'address', 'notes', 'openingBalanceNgn', 'openingBalanceDate', 'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.id == vendorId
        && d.farmId == farmId
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 150
        && d.phone is string && d.phone.size() <= 40
        && d.email is string && d.email.size() <= 200
        && d.address is string && d.address.size() <= 300
        && d.notes is string && d.notes.size() <= 500
        && d.openingBalanceNgn is number && d.openingBalanceNgn >= 0
        && isValidOptionalDateStr(d.openingBalanceDate)
        && d.status in ['active', 'inactive']
        && isValidId(d.createdBy)
        && isValidId(d.updatedBy)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // 1. User-to-Farm Binding (One-Farm-Per-Account Enforcement)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
      allow list: if false;
      allow create: if isEmailVerified()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserBinding(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().role == 'owner'
            && !exists(/databases/$(database)/documents/farms/$(incoming().farmId))
            && getAfter(/databases/$(database)/documents/farms/$(incoming().farmId)).data.ownerUid == uid
            && getAfter(/databases/$(database)/documents/farms/$(incoming().farmId)/members/$(uid)).data.role == 'owner'
          ) || (
            incoming().role in ['owner', 'staff']
            && exists(/databases/$(database)/documents/farms/$(incoming().farmId))
            && exists(/databases/$(database)/documents/pendingInvites/$(userEmailKey()))
            && get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.status == 'pending'
            && get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.farmId == incoming().farmId
            && getAfter(/databases/$(database)/documents/farms/$(incoming().farmId)/members/$(uid)).data.role == incoming().role
          )
        );
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(uid) && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------------
    // 2. Email-Keyed Pending Invitations (Zero Enumeration)
    // -------------------------------------------------------------------------
    match /pendingInvites/{emailKey} {
      allow get: if isEmailVerified()
        && isValidId(emailKey)
        && existing().emailLower == request.auth.token.email.lower();
      allow list: if false;
      allow create: if isEmailVerified()
        && isValidId(emailKey)
        && isValidPendingInvite(incoming(), emailKey)
        && incoming().status == 'pending'
        && incoming().acceptedByUid == ''
        && incoming().invitedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && canManageMembers(incoming().farmId);
      allow update: if isEmailVerified()
        && isValidId(emailKey)
        && isValidPendingInvite(incoming(), emailKey)
        && incoming().emailKey == existing().emailKey
        && incoming().farmId == existing().farmId
        && incoming().emailLower == existing().emailLower
        && incoming().invitedBy == existing().invitedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            canManageMembers(existing().farmId)
            && existing().status == 'pending'
            && incoming().status == 'revoked'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            existing().status == 'pending'
            && existing().emailLower == request.auth.token.email.lower()
            && incoming().status == 'accepted'
            && incoming().acceptedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/farms/$(existing().farmId)/members/$(request.auth.uid))
          )
        );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 3. Farms & Tenant-Scoped Subcollections
    // -------------------------------------------------------------------------
    match /farms/{farmId} {
      allow get: if isValidId(farmId) && isActiveMember(farmId);
      allow list: if false;
      allow create: if isEmailVerified()
        && isValidId(farmId)
        && isValidFarm(incoming(), farmId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmId == farmId;
      allow update: if isValidId(farmId)
        && isValidFarm(incoming(), farmId)
        && canEditSettings(farmId)
        && incoming().farmId == existing().farmId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'contactPhone', 'contactEmail', 'currency', 'timezone', 'updatedAt']);
      allow delete: if false;

      // Memberships
      match /members/{memberUid} {
        allow get: if isValidId(farmId)
          && isValidId(memberUid)
          && (
            (isEmailVerified() && request.auth.uid == memberUid && existing().farmId == farmId) ||
            canReadMembers(farmId)
          );
        allow list: if isValidId(farmId)
          && isEmailVerified()
          && canReadMembers(farmId);
        allow create: if isEmailVerified()
          && isValidId(farmId)
          && isValidId(memberUid)
          && isValidFarmMember(incoming(), farmId, memberUid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            // Bootstrap First Owner atomically with new Farm
            (
              memberUid == request.auth.uid
              && incoming().role == 'owner'
              && incoming().status == 'active'
              && incoming().createdBy == request.auth.uid
              && !exists(/databases/$(database)/documents/farms/$(farmId))
              && getAfter(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid
            ) ||
            // Invited staff accepting pending invite (bound strictly to pending invite permissions)
            (
              memberUid == request.auth.uid
              && incoming().role == get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.role
              && incoming().status == 'active'
              && exists(/databases/$(database)/documents/farms/$(farmId))
              && exists(/databases/$(database)/documents/pendingInvites/$(userEmailKey()))
              && get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.status == 'pending'
              && get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.farmId == farmId
              && get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.emailLower == request.auth.token.email.lower()
              && incoming().permissions == get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.permissions
              && incoming().jobTitle == get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.jobTitle
              && incoming().createdBy == get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.invitedBy
              && getAfter(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmId == farmId
              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == get(/databases/$(database)/documents/pendingInvites/$(userEmailKey())).data.role
            )
          );
        allow update: if isValidId(farmId)
          && isValidId(memberUid)
          && isValidFarmMember(incoming(), farmId, memberUid)
          && canManageMembers(farmId)
          && memberUid != request.auth.uid
          && existing().role == 'staff'
          && incoming().role == 'staff'
          && incoming().uid == existing().uid
          && incoming().farmId == existing().farmId
          && incoming().email == existing().email
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['jobTitle', 'status', 'permissions', 'departments', 'assignedPenIds', 'updatedAt']);
        allow delete: if false;
      }

      // Farm Invites Log
      match /invites/{inviteId} {
        allow get: if isValidId(farmId) && isValidId(inviteId) && canReadMembers(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && canReadMembers(farmId);
        allow create: if isValidId(farmId)
          && isValidId(inviteId)
          && isValidFarmInvite(incoming(), farmId, inviteId)
          && canManageMembers(farmId)
          && incoming().status == 'pending'
          && incoming().acceptedByUid == ''
          && incoming().invitedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId)
          && isValidId(inviteId)
          && isValidFarmInvite(incoming(), farmId, inviteId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().emailKey == existing().emailKey
          && incoming().emailLower == existing().emailLower
          && incoming().invitedBy == existing().invitedBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              canManageMembers(farmId)
              && existing().status == 'pending'
              && incoming().status == 'revoked'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            ) ||
            (
              isEmailVerified()
              && existing().status == 'pending'
              && existing().emailLower == request.auth.token.email.lower()
              && incoming().status == 'accepted'
              && incoming().acceptedByUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

      // Pens / Houses
      match /pens/{penId} {
        allow get: if isValidId(farmId) && isValidId(penId) && isActiveMember(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && isActiveMember(farmId);
        allow create: if isValidId(farmId)
          && isValidId(penId)
          && isValidPen(incoming(), farmId, penId)
          && canEditSettings(farmId)
          && incoming().createdBy == request.auth.uid
          && incoming().activeBatchId == ''
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId)
          && isValidId(penId)
          && isValidPen(incoming(), farmId, penId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().sector == existing().sector
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              canEditSettings(farmId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'capacity', 'notes', 'status', 'department', 'assignedMemberUids', 'updatedAt'])
            ) ||
            (
              (hasCrudPerm(farmId, 'batches', 'create') || hasCrudPerm(farmId, 'batches', 'edit'))
              && (incoming().activeBatchId == '' || existing().activeBatchId == '' || incoming().activeBatchId == existing().activeBatchId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['activeBatchId', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

      // Feed Catalogue
      match /feedItems/{feedItemId} {
        allow get: if isValidId(farmId) && isValidId(feedItemId) && isActiveMember(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && isActiveMember(farmId);
        allow create: if isValidId(farmId)
          && isValidId(feedItemId)
          && isValidFeedItem(incoming(), farmId, feedItemId)
          && canEditSettings(farmId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId)
          && isValidId(feedItemId)
          && isValidFeedItem(incoming(), farmId, feedItemId)
          && canEditSettings(farmId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['feedType', 'brand', 'defaultBagWeightKg', 'notes', 'status', 'updatedAt']);
        allow delete: if false;
      }

      // Feed Stock (Authoritative Gram Balances)
      match /feedStock/{feedItemId} {
        allow get: if isValidId(farmId) && isValidId(feedItemId) && isActiveMember(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && isActiveMember(farmId);
        allow create: if isValidId(farmId)
          && isValidId(feedItemId)
          && isValidFeedStock(incoming(), farmId, feedItemId)
          && (canEditSettings(farmId) || hasCrudPerm(farmId, 'feed', 'create'))
          && exists(/databases/$(database)/documents/farms/$(farmId)/feedItems/$(feedItemId))
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId)
          && isValidId(feedItemId)
          && isValidFeedStock(incoming(), farmId, feedItemId)
          && (hasCrudPerm(farmId, 'feed', 'create') || hasCrudPerm(farmId, 'feed', 'edit') || hasCrudPerm(farmId, 'feed', 'delete'))
          && incoming().feedItemId == existing().feedItemId
          && incoming().farmId == existing().farmId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['feedType', 'brand', 'balanceGrams', 'lastPurchaseDate', 'lastUnitCostPerGramNgn', 'updatedAt']);
        allow delete: if false;
      }

      // Sales Units & Configured Prices
      match /salesUnits/{unitId} {
        allow get: if isValidId(farmId) && isValidId(unitId) && isActiveMember(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && isActiveMember(farmId);
        allow create: if isValidId(farmId)
          && isValidId(unitId)
          && isValidSalesUnit(incoming(), farmId, unitId)
          && canEditSettings(farmId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(farmId)
          && isValidId(unitId)
          && isValidSalesUnit(incoming(), farmId, unitId)
          && canEditSettings(farmId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'eggCountPerUnit', 'currentPriceNgn', 'effectiveDate', 'status', 'updatedAt']);
        allow delete: if false;
      }

      // Batch Code Uniqueness Locks
      match /batchCodes/{codeKey} {
        allow get: if isValidId(farmId) && isValidId(codeKey) && hasCrudPerm(farmId, 'batches', 'read');
        allow list: if false;
        allow create: if isValidId(farmId)
          && isValidId(codeKey)
          && isValidBatchCodeLock(incoming(), farmId, codeKey)
          && hasCrudPerm(farmId, 'batches', 'create')
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/farms/$(farmId)/batches/$(incoming().batchId));
        allow update: if false;
        allow delete: if false;
      }

      // Poultry Batches
      match /batches/{batchId} {
        allow get: if isValidId(farmId) && isValidId(batchId) && isActiveMember(farmId);
        allow list: if isValidId(farmId) && isEmailVerified() && isActiveMember(farmId);
        allow create: if isValidId(farmId)
          && isValidId(batchId)
          && isValidBatch(incoming(), farmId, batchId)
          && hasCrudPerm(farmId, 'batches', 'create')
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/farms/$(farmId)/pens/$(incoming().penId));
        allow update: if isValidId(farmId)
          && isValidId(batchId)
          && isValidBatch(incoming(), farmId, batchId)
          && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().batchCode == existing().batchCode
          && incoming().createdBy == existing().createdBy
          && incoming().createdByName == existing().createdByName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time
          && (
            (
              hasCrudPerm(farmId, 'batches', 'edit')
              && incoming().diff(existing()).affectedKeys().hasOnly(['penId', 'penNameSnapshot', 'birdType', 'breed', 'strain', 'source', 'hatchDate', 'ageAtPlacementDays', 'placementDate', 'initialCount', 'maleCount', 'femaleCount', 'remarks', 'status', 'updatedBy', 'updatedAt'])
            ) ||
            (
              hasCrudPerm(farmId, 'batches', 'delete')
              && incoming().status == 'inactive'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedBy', 'updatedAt'])
            ) ||
            (
              isFarmOwner(farmId)
              && existing().status == 'active'
              && incoming().status == 'inactive'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedDate', 'finalLiveBirdCount', 'closeoutReason', 'averageBirdWeightKg', 'closeoutSummary', 'updatedBy', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

      // Egg Production Entries
      match /eggProduction/{entryId} {
        allow get: if isValidId(farmId) && isValidId(entryId) && (hasCrudPerm(farmId, 'production', 'read') || hasCrudPerm(farmId, 'eggStore', 'transfer') || canReadReports(farmId) || isBoundToFarm(farmId));
        allow list: if isValidId(farmId) && isEmailVerified() && (hasCrudPerm(farmId, 'production', 'read') || hasCrudPerm(farmId, 'eggStore', 'transfer') || canReadReports(farmId) || isBoundToFarm(farmId));
        allow create: if isValidId(farmId)
          && isValidId(entryId)
          && isValidEggProduction(incoming(), farmId, entryId)
      && (hasCrudPerm(farmId, 'production', 'create') || isBoundToFarm(farmId))
      && incoming().isVoided == false
      && incoming().status == 'PENDING'
      && incoming().voidReason == ''
          && incoming().voidedBy == ''
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/farms/$(farmId)/batches/$(incoming().batchId))
          && get(/databases/$(database)/documents/farms/$(farmId)/batches/$(incoming().batchId)).data.status == 'active';
        allow update: if isValidId(farmId)
      && isValidId(entryId)
      && existing().isVoided == false
      && (existing().status == 'PENDING' || isFarmOwner(farmId))
      && incoming().id == existing().id
          && incoming().farmId == existing().farmId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time
          && (
            (
              (hasCrudPerm(farmId, 'production', 'edit') || isBoundToFarm(farmId))
          && incoming().status == 'PENDING'
              && incoming().isVoided == false
              && isValidEggProduction(incoming(), farmId, entryId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['transactionDate', 'transactionTime', 'batchId', 'batchCodeSnapshot', 'penId', 'penNameSnapshot', 'birdAgeDaysAtTransaction', 'crates', 'pieces', 'intactEggs', 'crackedEggs', 'damagedEggs', 'totalEggs', 'remarks', 'updatedBy', 'updatedAt'])
            ) ||
            (
              (hasCrudPerm(farmId, 'production', 'delete') || isBoundToFarm(farmId))
          && incoming().status == 'VOIDED'
              && incoming().isVoided == true
              && incoming().voidReason.size() >= 1
              && incoming().voidedBy == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['isVoided', 'voidReason', 'voidedBy', 'updatedBy', 'updatedAt'])
            ) ||
            (
              canApproveProduction(farmId)
              && existing().status == 'PENDING'
              && incoming().status == 'APPROVED'
              && incoming().approvedBy == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedByName', 'approvedAt', 'approvalAuditId', 'updatedBy', 'updatedAt'])
            ) ||
            (
              isFarmOwner(farmId)
              && existing().status == 'APPROVED'
              && incoming().status == 'APPROVED'
              && incoming().adjustmentJustification is string
              && incoming().adjustmentJustification.size() >= 3
              && incoming().adjustmentJustification.size() <= 500
              && incoming().diff(existing()).affectedKeys().hasOnly(['crates', 'pieces', 'intactEggs', 'crackedEggs', 'damagedEggs', 'totalEggs', 'adjustmentJustification', 'updatedBy', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

    
  // One parent per batch and production date; the parent is the approval unit.
  match /productionRecords/{parentId} {
    allow get, list: if isValidId(farmId) && isEmailVerified() && (hasCrudPerm(farmId, 'production', 'read') || canApproveProduction(farmId) || canReadReports(farmId));
    allow create: if isValidId(farmId) && isValidId(parentId) && isActiveMember(farmId) && hasCrudPerm(farmId, 'production', 'create')
      && incoming().id == parentId && incoming().farmId == farmId && incoming().status == 'PENDING'
      && incoming().createdBy == request.auth.uid && incoming().updatedBy == request.auth.uid
      && incoming().createdAt == request.time && incoming().updatedAt == request.time;
    allow update: if isValidId(farmId) && isValidId(parentId) && (
      (canApproveProduction(farmId) && existing().status == 'PENDING' && incoming().status == 'APPROVED' && incoming().approvedBy == request.auth.uid)
      || (hasCrudPerm(farmId, 'production', 'edit') && existing().status == 'PENDING' && incoming().status == 'PENDING')
    ) && incoming().id == existing().id && incoming().farmId == existing().farmId;
    allow delete: if false;
  }

  // Feed Purchases (Stock-In)
      match /feedPurchases/{purchaseId} {
